<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemReview.Desktop.ViewModels"
        xmlns:behaviors="using:DemReview.Desktop.Behaviors"
        xmlns:controls="using:DemReview.Desktop.Controls"
        xmlns:l="using:DemReview.Desktop.Localization"
        xmlns:situations="using:DemReview.Application.Situations"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="DemReview.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900" MinWidth="1100" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        behaviors:FileDrop.Command="{Binding LoadFileCommand}">

    <!-- Подписи: {l:T 'русский', 'English'} — берутся на текущем языке при создании окна. -->

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding ReparseCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </Window.KeyBindings>

    <Window.Resources>
        <DataTemplate x:Key="OptionTemplate" x:DataType="vm:FilterOption">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>

        <!-- Вариант стороны: «T» и «CT» в цветах сторон -->
        <DataTemplate x:Key="SideOptionTemplate" x:DataType="vm:FilterOption">
            <TextBlock Text="{Binding Label}" Classes.t="{Binding IsT}" Classes.ct="{Binding IsCT}" />
        </DataTemplate>

        <!-- Строка игрока в боковой панели -->
        <DataTemplate x:Key="PlayerRowTemplate" x:DataType="vm:PlayerRowViewModel">
            <Button Classes="player" Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectPlayerCommand}" CommandParameter="{Binding}"
                    ToolTip.Tip="{Binding SteamIdText}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Classes="avatar" Classes.t="{Binding IsT}" Classes.me="{Binding IsMe}">
                        <TextBlock Text="{Binding Initials}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                            <Border Classes="badge me" IsVisible="{Binding IsMe}"><TextBlock Text="{l:T 'Вы', 'You'}" /></Border>
                        </StackPanel>
                        <TextBlock Classes="mono subtle" FontSize="11.5" Text="{Binding KdaText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Classes="mono subtle" FontSize="12.5" FontWeight="SemiBold" Text="{Binding DiffText}" VerticalAlignment="Center"
                               Classes.positive="{Binding IsDiffPositive}" Classes.negative="{Binding IsDiffNegative}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid ColumnDefinitions="64,280,*">
        <!-- ===== Полоса разделов ===== -->
        <Border BorderBrush="{StaticResource RailBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,16">
                <Border DockPanel.Dock="Top" Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}"
                        Margin="0,0,0,16" ToolTip.Tip="DemReview">
                    <controls:Icon Width="22" Height="22" Brush="{StaticResource OnAccentBrush}" StrokeThickness="2" Data="{StaticResource IconLogo}" />
                </Border>
                <Button DockPanel.Dock="Bottom" Classes="icon-button" Width="44" Height="44" CornerRadius="11" HorizontalAlignment="Center"
                        Background="{StaticResource CardBrush}" Command="{Binding OpenCommand}" IsEnabled="{Binding IsIdle}"
                        ToolTip.Tip="{l:T 'Открыть демку (Ctrl+O)', 'Open a demo (Ctrl+O)'}">
                    <controls:Icon Width="20" Height="20" Data="{StaticResource IconOpen}" />
                </Button>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <Button Classes="nav" Classes.active="{Binding IsRadarTab}" Command="{Binding SelectTabCommand}" CommandParameter="0">
                        <StackPanel Spacing="4">
                            <controls:Icon Width="22" Height="22" HorizontalAlignment="Center" Data="{StaticResource IconRadar}" />
                            <TextBlock Text="{l:T 'Радар', 'Radar'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsStatisticsTab}" Command="{Binding SelectTabCommand}" CommandParameter="1"
                            IsEnabled="{Binding HasMatch}">
                        <StackPanel Spacing="4">
                            <controls:Icon Width="22" Height="22" HorizontalAlignment="Center" Data="{StaticResource IconStats}" />
                            <TextBlock Text="{l:T 'Статистика', 'Stats'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsProfileTab}" Command="{Binding SelectTabCommand}" CommandParameter="2"
                            IsEnabled="{Binding HasMatch}">
                        <StackPanel Spacing="4">
                            <controls:Icon Width="22" Height="22" HorizontalAlignment="Center" Data="{StaticResource IconProfile}" />
                            <TextBlock Text="{l:T 'Профиль', 'Profile'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsGrenadesTab}" Command="{Binding SelectTabCommand}" CommandParameter="3"
                            ToolTip.Tip="{l:T 'Эффективность гранат и библиотека раскидок', 'Grenade effectiveness and the lineup library'}">
                        <StackPanel Spacing="4">
                            <controls:Icon Width="22" Height="22" HorizontalAlignment="Center" Data="{StaticResource IconGrenade}" />
                            <TextBlock Text="{l:T 'Гранаты', 'Grenades'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsLibraryTab}" Command="{Binding SelectTabCommand}" CommandParameter="4"
                            ToolTip.Tip="{l:T 'Библиотека демок и сводный профиль по нескольким матчам', 'Demo library and the combined profile across matches'}">
                        <StackPanel Spacing="4">
                            <controls:Icon Width="22" Height="22" HorizontalAlignment="Center" Data="{StaticResource IconLibrary}" />
                            <TextBlock Text="{l:T 'Библиотека', 'Library'}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="nav" Classes.active="{Binding IsSettingsTab}" Command="{Binding SelectTabCommand}" CommandParameter="5">
                        <StackPanel Spacing="4">
                            <controls:Icon Width="22" Height="22" HorizontalAlignment="Center" Data="{StaticResource IconSettings}" />
                            <TextBlock Text="{l:T 'Настройки', 'Settings'}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Игроки ===== -->
        <Border Grid.Column="1" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource RailBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,16">
                <!-- Матч -->
                <Border DockPanel.Dock="Top" Classes="card" CornerRadius="14" Padding="14" Margin="0,0,0,14">
                    <Grid>
                        <StackPanel Spacing="10" IsVisible="{Binding HasMatch}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Radar.MapTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Classes="pill" Padding="7,3" VerticalAlignment="Center">
                                    <TextBlock Classes="mono subtle" FontSize="11" Text="{Binding MapName}" />
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCombined}">
                                <Border Classes="badge neutral"><TextBlock Text="{l:T 'Сводный профиль', 'Combined profile'}" /></Border>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" IsVisible="{Binding !IsCombined}">
                                <TextBlock Classes="t" FontSize="12" Text="{Binding TTeamName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="mono" FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding TScore}" /><Run Text=" : " /><Run Text="{Binding CtScore}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" Classes="ct" FontSize="12" Text="{Binding CtTeamName}" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Classes="subtle" FontSize="12" Text="{Binding MatchDetails}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding !HasMatch}">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{l:T 'Демка не открыта', 'No demo open'}" />
                            <TextBlock Classes="hint" FontSize="12" Text="{l:T 'Список игроков появится после открытия демки.', 'The player list appears after you open a demo.'}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Поиск -->
                <TextBox DockPanel.Dock="Top" Text="{Binding PlayerSearch}" IsVisible="{Binding HasMatch}" Margin="0,0,0,10"
                         PlaceholderText="{l:T 'Найти игрока', 'Find a player'}">
                    <TextBox.InnerLeftContent>
                        <controls:Icon Width="16" Height="16" Margin="12,0,0,0" Brush="{StaticResource SubtleBrush}" StrokeThickness="2" Data="{StaticResource IconSearch}" />
                    </TextBox.InnerLeftContent>
                </TextBox>

                <ScrollViewer IsVisible="{Binding HasMatch}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="6,4,6,6">
                                <Border Classes="badge ct"><TextBlock Text="CT" /></Border>
                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding CtTeamName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="mono" FontWeight="SemiBold" Text="{Binding CtScore}" VerticalAlignment="Center" IsVisible="{Binding !IsCombined}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CtPlayers}" ItemTemplate="{StaticResource PlayerRowTemplate}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="6,4,6,6">
                                <Border Classes="badge t"><TextBlock Text="T" /></Border>
                                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding TTeamName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="mono" FontWeight="SemiBold" Text="{Binding TScore}" VerticalAlignment="Center" IsVisible="{Binding !IsCombined}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TPlayers}" ItemTemplate="{StaticResource PlayerRowTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Содержимое ===== -->
        <DockPanel Grid.Column="2">
            <!-- Строка состояния: прогресс разбора и отмена -->
            <Border DockPanel.Dock="Bottom" Padding="24,8" BorderBrush="{StaticResource RailBorderBrush}" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <TextBlock Classes="subtle" FontSize="12" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Grid.Column="1" Classes="bar" Width="240" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="ghost small" MinHeight="28" Content="{l:T 'Отмена (Esc)', 'Cancel (Esc)'}"
                            Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}" />
                </Grid>
            </Border>

            <!-- Баннеры -->
            <StackPanel DockPanel.Dock="Top" Margin="24,16,24,0" Spacing="10">
                <Border IsVisible="{Binding HasError}" Classes="card" CornerRadius="12" Padding="14,10"
                        Background="#1F1414" BorderBrush="{StaticResource DangerBorderBrush}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#F5C2BF" />
                        <Button Grid.Column="1" Classes="ghost small" Content="{l:T 'Закрыть', 'Close'}" Command="{Binding DismissErrorCommand}" />
                    </Grid>
                </Border>

                <Border IsVisible="{Binding Settings.HasUpdateBanner}" Classes="card" CornerRadius="12" Padding="14,8"
                        Background="#0F1A12" BorderBrush="#1F3A26">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <controls:Icon Width="18" Height="18" Brush="{StaticResource PositiveBrush}" StrokeThickness="2" Data="{StaticResource IconCheckCircle}" />
                        <TextBlock Grid.Column="1" Text="{Binding Settings.UpdateBannerText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Classes="accent small" Content="{l:T 'Открыть страницу релиза', 'Open the release page'}"
                                Command="{Binding Settings.OpenReleaseCommand}" />
                        <Button Grid.Column="3" Classes="ghost small" Content="{l:T 'Не напоминать', 'Do not remind'}"
                                Command="{Binding Settings.DismissUpdateCommand}" />
                    </Grid>
                </Border>

                <!-- Кто вы в этой демке: выбор основного игрока, пока он не задан -->
                <Border IsVisible="{Binding IsMainPlayerPromptVisible}" Classes="card" Padding="18,16"
                        BorderBrush="{StaticResource AccentSoftBorderBrush}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="{l:T 'Кто вы в этой демке?', 'Which player are you in this demo?'}" />
                            <TextBlock Classes="hint"
                                       Text="{l:T 'Выберите себя — DemReview запомнит ваш SteamID. В следующих демках вы будете выбраны сразу и отмечены в списке игроков: не придётся искать себя среди десяти ников. А демки с вашим участием сохраняются в «Библиотеку» — из них собирается личный профиль: привычки, роли и ошибки за много игр.', 'Pick yourself and DemReview will remember your SteamID. In the next demos you will be selected right away and marked in the player list, so you will not have to look for yourself among ten nicknames. And demos you played in are saved to the Library, building up a personal profile: habits, roles and mistakes across many games.'}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding MainPlayerCandidates}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlayerRowViewModel">
                                    <Button Classes="small" Padding="6,0,12,0"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChooseMainPlayerCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Classes="avatar" Classes.t="{Binding IsT}" Width="24" Height="24" CornerRadius="12">
                                                <TextBlock Text="{Binding Initials}" FontSize="9.5" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="{l:T 'SteamID хранится только на этом компьютере и никуда не отправляется. Изменить выбор или ввести SteamID вручную можно в «Настройках».', 'Your SteamID is stored only on this computer and is never sent anywhere. You can change it or enter a SteamID manually in Settings.'}" />
                            <Button Grid.Column="1" Classes="small" Content="{l:T 'Меня нет в этой демке', 'I am not in this demo'}" Command="{Binding SkipMainPlayerPromptCommand}" />
                            <Button Grid.Column="2" Classes="ghost small" Content="{l:T 'Не спрашивать', 'Do not ask again'}" Command="{Binding DisableMainPlayerPromptCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Panel>
                <!-- ===== Радар ===== -->
                <DockPanel IsVisible="{Binding IsRadarTab}" Margin="24,20,24,16">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Classes="h1" Text="{l:T 'Радар', 'Radar'}" />
                            <TextBlock Classes="subtle" FontSize="13" Margin="0,2,0,0">
                                <Run Text="{Binding SelectedPlayerName}" />
                                <Run Text="{l:T '· все маршруты, гранаты и смерти за матч', '· all routes, grenades and deaths in the match'}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding OpenCommand}" IsEnabled="{Binding IsIdle}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{l:T 'Открыть демку', 'Open demo'}" FontWeight="Medium" VerticalAlignment="Center" />
                                <Border Background="{StaticResource CardBorderBrush}" CornerRadius="5" Padding="6,2">
                                    <TextBlock Classes="mono muted" FontSize="11" Text="Ctrl+O" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="accent" Command="{Binding Profile.ExportCommand}"
                                ToolTip.Tip="{l:T 'Экспорт профиля в Markdown или JSON (Ctrl+E)', 'Export the profile to Markdown or JSON (Ctrl+E)'}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:Icon Width="16" Height="16" StrokeThickness="2" Data="{StaticResource IconDownload}" />
                                <TextBlock Text="{l:T 'Экспорт профиля', 'Export profile'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Пустое состояние -->
                    <Border IsVisible="{Binding !HasMatch}" Classes="card" BorderBrush="{StaticResource ControlBorderBrush}" Background="{StaticResource RadarCardBrush}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                            <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource NavActiveBrush}" HorizontalAlignment="Center">
                                <controls:Icon Width="30" Height="30" Brush="{StaticResource AccentBrush}" Data="{StaticResource IconOpen}" />
                            </Border>
                            <TextBlock Classes="h2" FontSize="18" HorizontalAlignment="Center" Text="{l:T 'Перетащите сюда файл .dem', 'Drop a .dem file here'}" />
                            <TextBlock Classes="subtle" HorizontalAlignment="Center"
                                       Text="{l:T 'или откройте его кнопкой ниже (Ctrl+O)', 'or open it with the button below (Ctrl+O)'}" />
                            <Button Classes="accent" HorizontalAlignment="Center" Content="{l:T 'Открыть демку…', 'Open demo…'}"
                                    Command="{Binding OpenCommand}" IsEnabled="{Binding IsIdle}" />
                        </StackPanel>
                    </Border>

                    <DockPanel IsVisible="{Binding HasMatch}">
                        <!-- Фильтры -->
                        <WrapPanel DockPanel.Dock="Top" ItemSpacing="10" LineSpacing="10" Margin="0,0,0,16" DataContext="{Binding Filter}" x:DataType="vm:FilterViewModel">
                            <ListBox Theme="{StaticResource SegmentedList}" ItemsSource="{Binding Sides}" SelectedItem="{Binding SelectedSide}"
                                     ItemTemplate="{StaticResource SideOptionTemplate}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="subtle" Text="{l:T 'Раунд', 'Round'}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Rounds}" SelectedItem="{Binding SelectedRound}" MaxDropDownHeight="400" MinWidth="130"
                                          ItemTemplate="{StaticResource OptionTemplate}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="subtle" Text="{l:T 'Закупка', 'Buy'}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Buys}" SelectedItem="{Binding SelectedBuy}" MinWidth="150"
                                          ItemTemplate="{StaticResource OptionTemplate}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="subtle" Text="{l:T 'Гранаты', 'Grenades'}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Grenades}" SelectedItem="{Binding SelectedGrenade}" MinWidth="150"
                                          ItemTemplate="{StaticResource OptionTemplate}" />
                            </StackPanel>
                            <Button Classes="ghost" MinHeight="38" Content="{l:T 'Сбросить', 'Reset'}" Command="{Binding ResetCommand}" IsEnabled="{Binding IsActive}" />
                        </WrapPanel>

                        <Grid ColumnDefinitions="*,16,360" DataContext="{Binding Radar}" x:DataType="vm:RadarViewModel">
                            <!-- Радар -->
                            <Border Classes="card" Background="{StaticResource RadarCardBrush}" ClipToBounds="True">
                                <DockPanel>
                                    <!-- Сводка момента и масштаб -->
                                    <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding Timeline.RoundTitle}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="muted" FontSize="12.5" Text="{Binding Timeline.ContextText}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Timeline.ContextText}" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                <Button Classes="icon-button compact" Click="OnZoomIn" ToolTip.Tip="{l:T 'Приблизить', 'Zoom in'}">
                                                    <controls:Icon Width="16" Height="16" StrokeThickness="2" Data="{StaticResource IconPlus}" />
                                                </Button>
                                                <Button Classes="icon-button compact" Click="OnZoomOut" ToolTip.Tip="{l:T 'Отдалить', 'Zoom out'}">
                                                    <controls:Icon Width="16" Height="16" StrokeThickness="2" Data="{StaticResource IconMinus}" />
                                                </Button>
                                                <Button Classes="icon-button compact" Click="OnResetView" ToolTip.Tip="{l:T 'Сбросить вид (двойной клик)', 'Reset view (double-click)'}">
                                                    <controls:Icon Width="15" Height="15" StrokeThickness="2" Data="{StaticResource IconFit}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Таймлайн -->
                                    <Border DockPanel.Dock="Bottom" Padding="14,10" Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                                            DataContext="{Binding Timeline}" x:DataType="vm:TimelineViewModel">
                                        <Grid>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14" IsVisible="{Binding IsEnabled}">
                                                <Button Width="44" Height="44" CornerRadius="22" Padding="0" Classes="accent" HorizontalContentAlignment="Center"
                                                        Command="{Binding PlayPauseCommand}" ToolTip.Tip="{Binding PlayButtonText}">
                                                    <Panel>
                                                        <controls:Icon Width="18" Height="18" IsVisible="{Binding !IsPlaying}" IsFilled="True" Data="{StaticResource IconPlay}" />
                                                        <controls:Icon Width="18" Height="18" IsVisible="{Binding IsPlaying}" IsFilled="True" Data="{StaticResource IconPause}" />
                                                    </Panel>
                                                </Button>
                                                <TextBlock Grid.Column="1" Classes="mono" FontSize="13" VerticalAlignment="Center">
                                                    <Run Text="{Binding CurrentTimeText}" />
                                                    <Run Text="{Binding TotalTimeText}" Foreground="{StaticResource SubtleBrush}" />
                                                </TextBlock>
                                                <Slider Grid.Column="2" Minimum="{Binding MinTick}" Maximum="{Binding MaxTick}"
                                                        Value="{Binding CurrentTick}" VerticalAlignment="Center" />
                                                <ListBox Grid.Column="3" Theme="{StaticResource SegmentedList}" Padding="3" CornerRadius="9"
                                                         ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="x:Double">
                                                            <TextBlock Classes="mono" FontSize="12" Text="{Binding StringFormat='×{0}'}" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                    <ListBox.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="Padding" Value="9,6" />
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </ListBox.Styles>
                                                </ListBox>
                                            </Grid>
                                            <TextBlock IsVisible="{Binding !IsEnabled}" Classes="subtle" FontSize="12.5" TextWrapping="Wrap"
                                                       VerticalAlignment="Center" Text="{Binding TimeText}" />
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <controls:RadarControl x:Name="RadarView" MapImage="{Binding MapImage}" Routes="{Binding Routes}"
                                                               HighlightedRounds="{Binding HighlightedRounds}"
                                                               ShowRoutes="{Binding ShowRoutes}" RadarToWorld="{Binding RadarToWorld}"
                                                               Grenades="{Binding Grenades}" HighlightedGrenades="{Binding HighlightedGrenades}"
                                                               ShowGrenades="{Binding ShowGrenades}" Heatmap="{Binding Heatmap}"
                                                               Deaths="{Binding Deaths}" Players="{Binding Players}"
                                                               DamageTexts="{Binding DamageTexts}" />

                                        <!-- Киллфид (таймлайн): убийства и смерть анализируемого игрока выделены рамкой -->
                                        <ItemsControl ItemsSource="{Binding KillFeed}" IsVisible="{Binding HasKillFeed}" IsHitTestVisible="False"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:KillFeedEntry">
                                                    <Border Background="{Binding Background}" BorderBrush="{Binding BorderBrush}" BorderThickness="1"
                                                            CornerRadius="8" Padding="10,5" Margin="0,0,0,4" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Attacker}" Foreground="{Binding AttackerBrush}" FontWeight="SemiBold" FontSize="12"
                                                                       IsVisible="{Binding HasAttacker}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Assist}" Foreground="{Binding AssistBrush}" FontSize="11.5"
                                                                       IsVisible="{Binding HasAssist}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Weapon}" Classes="subtle" FontSize="12" VerticalAlignment="Center" />
                                                            <Border IsVisible="{Binding Headshot}" Background="#D8DCE2" CornerRadius="3" Padding="3,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="HS" Foreground="Black" FontSize="10" FontWeight="Bold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Victim}" Foreground="{Binding VictimBrush}" FontWeight="SemiBold" FontSize="12"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border IsVisible="{Binding HasMapHint}" Classes="overlay" Margin="14,14,14,0" Padding="12,8"
                                                HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding MapHint}" TextWrapping="Wrap" MaxWidth="520" FontSize="12" />
                                                <Button Classes="small" HorizontalAlignment="Left" Content="{l:T 'Открыть папку maps', 'Open the maps folder'}"
                                                        Command="{Binding OpenMapsFolderCommand}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Режим раундов-примеров паттерна -->
                                        <Border IsVisible="{Binding HasFocus}" Classes="overlay" Margin="14,0,14,56" Padding="12,8"
                                                HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderBrush="{StaticResource AccentSoftBorderBrush}" MaxWidth="720">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding FocusText}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="small" Content="{l:T 'Показать все', 'Show all'}" Command="{Binding ClearSelectionCommand}" />
                                            </Grid>
                                        </Border>

                                        <!-- Легенда -->
                                        <Border Classes="overlay" Margin="14" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                            <WrapPanel ItemSpacing="12" LineSpacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="14" Height="3" CornerRadius="2" Background="{StaticResource TBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Маршруты T', 'T routes'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Width="14" Height="3" CornerRadius="2" Background="{StaticResource CtLineBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Маршруты CT', 'CT routes'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="10" Height="10" Stroke="#9AA3B2" StrokeDashArray="2,2" VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Дым', 'Smoke'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="10" Height="10" Fill="#FF8C1A" VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Огонь', 'Fire'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="10" Height="10" Fill="#FAF078" VerticalAlignment="Center" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Флешка', 'Flash'}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <controls:Icon Width="11" Height="11" VerticalAlignment="Center" Brush="#FF3C3C" StrokeThickness="3" Data="{StaticResource IconClose}" />
                                                    <TextBlock Classes="muted" FontSize="12" Text="{l:T 'Смерть', 'Death'}" />
                                                </StackPanel>
                                            </WrapPanel>
                                        </Border>

                                        <TextBlock Classes="subtle" FontSize="11.5" Margin="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                   IsHitTestVisible="False" IsVisible="{Binding !HasKillFeed}"
                                                   Text="{l:T 'Колесо — масштаб · перетаскивание — сдвиг · наведите на игрока — ник', 'Wheel — zoom · drag — pan · hover a player — nickname'}" />

                                        <TextBlock IsVisible="{Binding !RoundRows.Count}" Classes="subtle"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Text="{l:T 'Выберите игрока в списке слева, чтобы увидеть его маршруты.', 'Select a player in the list on the left to see their routes.'}" />
                                    </Grid>
                                </DockPanel>
                            </Border>

                            <!-- Слои и списки -->
                            <DockPanel Grid.Column="2">
                                <Border DockPanel.Dock="Top" Classes="card" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel Spacing="2">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                            <TextBlock Classes="caption" Text="{l:T 'СЛОИ', 'LAYERS'}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="ghost small" MinHeight="28" Padding="8,0" FontSize="12"
                                                    Content="{l:T 'Снять выделение', 'Clear selection'}" Command="{Binding ClearSelectionCommand}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="36">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" FontSize="13.5" Text="{l:T 'Маршруты', 'Routes'}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding ShowRoutes}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="36">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="#9AA3B2" />
                                            <TextBlock Grid.Column="1" FontSize="13.5" Text="{l:T 'Гранаты', 'Grenades'}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding ShowGrenades}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="36">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="#F26A62" />
                                            <TextBlock Grid.Column="1" FontSize="13.5" Text="{l:T 'Смерти', 'Deaths'}" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="2" IsChecked="{Binding ShowDeaths}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" MinHeight="36">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="#F0663A" />
                                            <TextBlock Grid.Column="1" FontSize="13.5" Text="{l:T 'Тепловая карта', 'Heatmap'}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="2" MinHeight="32" FontSize="12.5" ItemsSource="{x:Static vm:RadarViewModel.HeatmapModes}"
                                                      SelectedItem="{Binding SelectedHeatmapMode}" IsEnabled="{Binding ShowHeatmap}"
                                                      ItemTemplate="{StaticResource OptionTemplate}" />
                                            <ToggleSwitch Grid.Column="3" IsChecked="{Binding ShowHeatmap}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="12">
                                    <TabControl Theme="{StaticResource SegmentedTabs}" HorizontalContentAlignment="Stretch" Padding="0,10,0,0">
                                        <TabControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </TabControl.ItemsPanel>
                                        <TabItem Header="{l:T 'Раунды', 'Rounds'}" FontSize="12.5" Padding="6,7">
                                            <ListBox Theme="{StaticResource CardList}" ItemsSource="{Binding RoundRows}" SelectedItem="{Binding SelectedRound}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RouteRoundRow">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding Title}" />
                                                                <Border Grid.Column="1" Classes="badge" Classes.t="{Binding IsT}" Classes.ct="{Binding !IsT}">
                                                                    <TextBlock Text="{Binding SideText}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="3" FontSize="11.5" FontWeight="Medium" Text="{Binding FateText}"
                                                                           Classes.negative="{Binding Died}" Classes.positive="{Binding !Died}" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Steps}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="2" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:RouteStep">
                                                                        <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}">
                                                                            <Run Text="{Binding Zone}" />
                                                                            <Run Classes="mono" FontSize="11" Foreground="{StaticResource SubtleBrush}" Text="{Binding Time}" />
                                                                        </TextBlock>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Classes="subtle" FontSize="12" Text="{Binding MoreStepsText}" IsVisible="{Binding HasMoreSteps}" />
                                                            <TextBlock Classes="subtle" FontSize="12" Text="{Binding ZonesText}" IsVisible="{Binding HasNoZones}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </TabItem>
                                        <TabItem Header="{l:T 'Частые', 'Frequent'}" FontSize="12.5" Padding="6,7">
                                            <Grid>
                                                <TextBlock IsVisible="{Binding !FrequentRoutes.Count}" Classes="hint" Margin="4,8"
                                                           Text="{l:T 'Повторяющихся маршрутов (одинаковые первые 3 зоны минимум в 2 раундах) нет.', 'No repeated routes (same first 3 zones in at least 2 rounds).'}" />
                                                <ListBox Theme="{StaticResource CardList}" ItemsSource="{Binding FrequentRoutes}" SelectedItem="{Binding SelectedFrequentRoute}">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:FrequentRouteRow">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding Header}" />
                                                                <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" Text="{Binding ZonesText}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="subtle mono" FontSize="11.5" Text="{Binding RoundsText}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </TabItem>
                                        <TabItem Header="{l:T 'Гранаты', 'Grenades'}" FontSize="12.5" Padding="6,7">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="2,0,2,10">
                                                    <ItemsControl ItemsSource="{Binding GrenadeSummary}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:GrenadeSummaryRow">
                                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Text2Brush}" TextWrapping="Wrap" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding FlashSummaryText}" Classes="subtle" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TabControl Theme="{StaticResource SegmentedTabs}" Padding="0,10,0,0">
                                                    <TabItem Header="{l:T 'Раскидки', 'Lineups'}" FontSize="12" Padding="12,5">
                                                        <Grid>
                                                            <TextBlock IsVisible="{Binding !GrenadeClusters.Count}" Classes="hint" Margin="4,8"
                                                                       Text="{l:T 'Повторяющихся раскидок (тот же тип, близкие точки броска и падения минимум в 2 бросках) нет.', 'No repeated lineups (same type, close throw and landing points in at least 2 throws).'}" />
                                                            <ListBox Theme="{StaticResource CardList}" ItemsSource="{Binding GrenadeClusters}" SelectedItem="{Binding SelectedCluster}">
                                                                <ListBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:GrenadeClusterRow">
                                                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2">
                                                                            <StackPanel Spacing="3">
                                                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Header}" TextWrapping="Wrap" />
                                                                                <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" Text="{Binding RouteText}" TextWrapping="Wrap" />
                                                                                <TextBlock Classes="subtle mono" FontSize="11.5" Text="{Binding RoundsText}" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="1" Classes="icon-button compact" VerticalAlignment="Top"
                                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Grenades.CopyThrowCommand}" CommandParameter="{Binding Representative}"
                                                                                    ToolTip.Tip="{l:T 'Скопировать setpos / setang — встать в точку броска на своём сервере', 'Copy setpos / setang to stand on the throw spot on your own server'}">
                                                                                <controls:Icon Width="15" Height="15" Data="{StaticResource IconCopy}" />
                                                                            </Button>
                                                                            <Button Grid.Column="2" Classes="icon-button compact" VerticalAlignment="Top"
                                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Grenades.SaveThrowCommand}" CommandParameter="{Binding Representative}"
                                                                                    ToolTip.Tip="{l:T 'Сохранить в библиотеку раскидок', 'Save to the lineup library'}">
                                                                                <controls:Icon Width="15" Height="15" Data="{StaticResource IconBookmark}" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                            </ListBox>
                                                        </Grid>
                                                    </TabItem>
                                                    <TabItem Header="{l:T 'Все броски', 'All throws'}" FontSize="12" Padding="12,5">
                                                        <ListBox Theme="{StaticResource CardList}" ItemsSource="{Binding GrenadeThrows}" SelectedItem="{Binding SelectedThrow}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:GrenadeThrowRow">
                                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="2">
                                                                        <StackPanel Spacing="3">
                                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Header}" TextWrapping="Wrap" />
                                                                            <TextBlock Classes="subtle" FontSize="12" Text="{Binding Details}" TextWrapping="Wrap" />
                                                                        </StackPanel>
                                                                        <Button Grid.Column="3" Classes="icon-button compact" VerticalAlignment="Top"
                                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WatchThrowCommand}" CommandParameter="{Binding Throw}"
                                                                                ToolTip.Tip="{l:T 'Смотреть бросок: раунд откроется на таймлайне за 2 с до броска, на паузе', 'Watch the throw: the round opens on the timeline 2 s before the throw, paused'}">
                                                                            <controls:Icon Width="15" Height="15" Data="{StaticResource IconPlay}" />
                                                                        </Button>
                                                                        <Button Grid.Column="1" Classes="icon-button compact" VerticalAlignment="Top"
                                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Grenades.CopyThrowCommand}" CommandParameter="{Binding Throw}"
                                                                                ToolTip.Tip="{l:T 'Скопировать setpos / setang — встать в точку броска на своём сервере', 'Copy setpos / setang to stand on the throw spot on your own server'}">
                                                                            <controls:Icon Width="15" Height="15" Data="{StaticResource IconCopy}" />
                                                                        </Button>
                                                                        <Button Grid.Column="2" Classes="icon-button compact" VerticalAlignment="Top"
                                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Grenades.SaveThrowCommand}" CommandParameter="{Binding Throw}"
                                                                                ToolTip.Tip="{l:T 'Сохранить в библиотеку раскидок', 'Save to the lineup library'}">
                                                                            <controls:Icon Width="15" Height="15" Data="{StaticResource IconBookmark}" />
                                                                        </Button>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </TabItem>
                                                </TabControl>
                                            </DockPanel>
                                        </TabItem>
                                        <TabItem Header="{l:T 'Тайминги', 'Timings'}" FontSize="12.5" Padding="6,7">
                                            <DataGrid ItemsSource="{Binding ZoneTimings}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" RowHeight="34">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="{l:T 'Ст.', 'Side'}" Binding="{Binding Side}" x:DataType="vm:ZoneTimingRow" />
                                                    <DataGridTextColumn Header="{l:T 'Зона', 'Zone'}" Binding="{Binding Zone}" x:DataType="vm:ZoneTimingRow" Width="*" />
                                                    <DataGridTextColumn Header="{l:T 'Медиана', 'Median'}" Binding="{Binding Median}" x:DataType="vm:ZoneTimingRow" />
                                                    <DataGridTextColumn Header="{l:T 'Разброс', 'Range'}" Binding="{Binding Range}" x:DataType="vm:ZoneTimingRow" />
                                                    <DataGridTextColumn Header="{l:T 'Р.', 'Rds'}" Binding="{Binding Rounds}" x:DataType="vm:ZoneTimingRow" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </TabItem>
                                    </TabControl>
                                </Border>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </DockPanel>

                <!-- ===== Статистика ===== -->
                <DockPanel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsStatisticsTab}" Margin="24,20,24,16" DataContext="{Binding Statistics}" x:DataType="vm:StatisticsViewModel">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Classes="h1" Text="{l:T 'Статистика', 'Statistics'}" />
                        <TextBlock Classes="subtle" FontSize="13" Margin="0,2,0,0">
                            <Run Text="{Binding PlayerName}" />
                            <Run Text="{l:T '· каждый раунд как «условия → решение»', '· every round as “conditions → decision”'}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock IsVisible="{Binding !HasPlayer}" Classes="subtle" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{l:T 'Выберите игрока в списке слева.', 'Select a player in the list on the left.'}" />

                    <DockPanel IsVisible="{Binding HasPlayer}">
                        <!-- Плитки -->
                        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tiles}" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="12" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatTile">
                                    <Border Classes="card" CornerRadius="14" Padding="16,14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="subtle" FontSize="12" Text="{Binding Label}" />
                                            <TextBlock Classes="mono" FontSize="26" FontWeight="SemiBold" Text="{Binding Value}" />
                                            <TextBlock FontSize="12" Classes="subtle">
                                                <Run Classes="t" Text="{Binding TText}" /><Run Text=" · " /><Run Classes="ct" Text="{Binding CtText}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Фильтры: сторона и закупка -->
                        <WrapPanel DockPanel.Dock="Top" ItemSpacing="10" LineSpacing="10" Margin="0,0,0,16"
                                   DataContext="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Filter}" x:DataType="vm:FilterViewModel">
                            <ListBox Theme="{StaticResource SegmentedList}" ItemsSource="{Binding Sides}" SelectedItem="{Binding SelectedSide}"
                                     ItemTemplate="{StaticResource SideOptionTemplate}" />
                            <TextBlock Classes="subtle" Text="{l:T 'Закупка', 'Buy'}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            <ListBox Theme="{StaticResource ChipList}" ItemsSource="{Binding Buys}" SelectedItem="{Binding SelectedBuy}"
                                     ItemTemplate="{StaticResource OptionTemplate}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="subtle" Text="{l:T 'Раунд', 'Round'}" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Rounds}" SelectedItem="{Binding SelectedRound}" MaxDropDownHeight="400" MinWidth="130"
                                          ItemTemplate="{StaticResource OptionTemplate}" />
                            </StackPanel>
                        </WrapPanel>

                        <TabControl Theme="{StaticResource SegmentedTabs}" Padding="0,14,0,0">
                            <TabItem Header="{l:T 'Ситуации игрока', 'Player situations'}">
                                <Border Classes="card" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding SituationRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                                              FrozenColumnCount="1" Classes="striped">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{l:T 'Р.', 'Rd'}" SortMemberPath="Round">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:SituationRowViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Classes="mono muted" Width="20" TextAlignment="Right" Text="{Binding Round}" />
                                                            <Border Classes="badge" Classes.t="{Binding IsT}" Classes.ct="{Binding !IsT}" MinWidth="24">
                                                                <TextBlock Text="{Binding Side}" HorizontalAlignment="Center" />
                                                            </Border>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{l:T 'Счёт', 'Score'}" Binding="{Binding ScoreText}" FontFamily="{StaticResource MonoFont}"
                                                                x:DataType="vm:SituationRowViewModel" />
                                            <DataGridTemplateColumn Header="{l:T 'Закупка · своя / команды / соперника', 'Buy · own / team / enemy'}" SortMemberPath="Buy">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:SituationRowViewModel">
                                                        <ItemsControl ItemsSource="{Binding Buys}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:BuyChip">
                                                                    <Border Classes="buy" Classes.pistol="{Binding IsPistol}" Classes.eco="{Binding IsEco}"
                                                                            Classes.force="{Binding IsForce}" Classes.full="{Binding IsFull}" ToolTip.Tip="{Binding Tooltip}">
                                                                        <TextBlock Text="{Binding Label}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{l:T 'Экипировка · своя / ср.', 'Equipment · own / avg'}" SortMemberPath="Equipment">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:SituationRowViewModel">
                                                        <TextBlock Classes="mono" VerticalAlignment="Center">
                                                            <Run Text="{Binding OwnEquipment}" />
                                                            <Run Text="{Binding TeamEquipment}" Foreground="{StaticResource SubtleBrush}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{l:T 'Маршрут', 'Route'}" Binding="{Binding Route}" Foreground="{StaticResource Text2Brush}"
                                                                x:DataType="vm:SituationRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Итоговая позиция', 'Final position'}" Binding="{Binding FinalZone}" FontWeight="SemiBold"
                                                                x:DataType="vm:SituationRowViewModel" />
                                            <DataGridTemplateColumn Header="{l:T 'Гранаты', 'Grenades'}" SortMemberPath="Grenades">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:SituationRowViewModel">
                                                        <Panel VerticalAlignment="Center">
                                                            <ItemsControl ItemsSource="{Binding GrenadeChips}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:GrenadeChip">
                                                                        <Border Background="{StaticResource ControlBrush}" CornerRadius="6" Padding="6,2,7,2">
                                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                <Ellipse Width="7" Height="7" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                                                <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" Text="{Binding Label}" />
                                                                                <TextBlock Classes="mono subtle" FontSize="12" Text="{Binding CountText}" IsVisible="{Binding HasCount}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="—" Foreground="{StaticResource FaintBrush}" IsVisible="{Binding HasNoGrenades}" />
                                                        </Panel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="{l:T 'Первый контакт', 'First contact'}" SortMemberPath="ContactFraction">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:SituationRowViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                            <ProgressBar Classes="bar thin" Width="64" Minimum="0" Maximum="1" Value="{Binding ContactFraction}"
                                                                         Classes.negative="{Binding IsAggressive}" Classes.ct="{Binding IsPassive}"
                                                                         IsVisible="{Binding HasContact}" VerticalAlignment="Center" />
                                                            <TextBlock Classes="mono" Text="{Binding ContactTime}" />
                                                            <TextBlock Classes="mono subtle" FontSize="11.5" Text="{Binding Matchup}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="{l:T 'Агрессия', 'Aggression'}" Binding="{Binding Aggression}" x:DataType="vm:SituationRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Первая дуэль', 'Opening duel'}" Binding="{Binding FirstDuel}" x:DataType="vm:SituationRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Урон', 'Damage'}" Binding="{Binding Damage}" FontFamily="{StaticResource MonoFont}"
                                                                x:DataType="vm:SituationRowViewModel" />
                                            <DataGridTemplateColumn Header="{l:T 'Итог', 'Outcome'}" SortMemberPath="Outcome">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:SituationRowViewModel">
                                                        <TextBlock Text="{Binding Outcome}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                                   Classes.positive="{Binding RoundWon}" Classes.negative="{Binding !RoundWon}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>

                            <TabItem Header="{l:T 'Условия → действия', 'Conditions → actions'}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="0,0,0,12">
                                        <TextBlock Classes="subtle" Text="{l:T 'Таблица', 'Table'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}" MinWidth="300">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="situations:FrequencyTable">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Classes="hint" FontSize="12.5" VerticalAlignment="Center"
                                                   Text="{l:T 'Доля — как часто решение принималось при этом условии. Малая выборка одной демки: смотрите на «из N».', 'Share is how often the decision was made under this condition. One demo is a small sample: look at “of N”.'}" />
                                    </Grid>
                                    <Border Classes="card" ClipToBounds="True">
                                        <DataGrid ItemsSource="{Binding FrequencyRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                                                  Classes="striped">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{l:T 'Условие', 'Condition'}" Binding="{Binding Condition}" x:DataType="vm:FrequencyRowViewModel" />
                                                <DataGridTextColumn Header="{l:T 'Решение', 'Decision'}" Binding="{Binding Decision}" x:DataType="vm:FrequencyRowViewModel" Width="*" />
                                                <DataGridTextColumn Header="{l:T 'Раз', 'Times'}" Binding="{Binding Count}" FontFamily="{StaticResource MonoFont}" x:DataType="vm:FrequencyRowViewModel" />
                                                <DataGridTextColumn Header="{l:T 'Доля', 'Share'}" Binding="{Binding Share}" SortMemberPath="ShareValue" FontFamily="{StaticResource MonoFont}"
                                                                    x:DataType="vm:FrequencyRowViewModel" />
                                                <DataGridTextColumn Header="{l:T 'Раунды', 'Rounds'}" Binding="{Binding Rounds}" FontFamily="{StaticResource MonoFont}"
                                                                    Foreground="{StaticResource MutedBrush}" x:DataType="vm:FrequencyRowViewModel" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="{l:T 'Раунды матча', 'Match rounds'}">
                                <Border Classes="card" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding MatchRounds}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True"
                                              Classes="striped">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T 'Раунд', 'Round'}" Binding="{Binding Number}" FontFamily="{StaticResource MonoFont}" x:DataType="vm:RoundRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Счёт до (T : CT)', 'Score before (T : CT)'}" Binding="{Binding ScoreBefore}" FontFamily="{StaticResource MonoFont}"
                                                                x:DataType="vm:RoundRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Закупка T', 'T buy'}" Binding="{Binding BuyT}" x:DataType="vm:RoundRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Закупка CT', 'CT buy'}" Binding="{Binding BuyCT}" x:DataType="vm:RoundRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Победитель', 'Winner'}" Binding="{Binding Winner}" FontWeight="SemiBold" x:DataType="vm:RoundRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Причина', 'Reason'}" Binding="{Binding Reason}" x:DataType="vm:RoundRowViewModel" Width="*" />
                                            <DataGridTextColumn Header="{l:T 'Длительность', 'Duration'}" Binding="{Binding Duration}" FontFamily="{StaticResource MonoFont}"
                                                                x:DataType="vm:RoundRowViewModel" />
                                            <DataGridTextColumn Header="{l:T 'Овертайм', 'Overtime'}" Binding="{Binding Overtime}" x:DataType="vm:RoundRowViewModel" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </DockPanel>

                <!-- ===== Профиль игрока ===== -->
                <Grid IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsProfileTab}" DataContext="{Binding Profile}" x:DataType="vm:ProfileViewModel">
                    <TextBlock IsVisible="{Binding !HasProfile}" Classes="subtle" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Text="{Binding IsBuilding, Converter={x:Static vm:ProfileConverters.EmptyText}}" />
                    <ScrollViewer IsVisible="{Binding HasProfile}">
                        <StackPanel Margin="24,20,24,32" Spacing="18">
                            <!-- Заголовок -->
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Classes="avatar" Classes.me="{Binding IsMe}" Width="52" Height="52" CornerRadius="26">
                                    <TextBlock Text="{Binding Initials}" FontSize="17" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="h1" FontSize="24" Text="{Binding Name}" />
                                        <Border Classes="badge me" IsVisible="{Binding IsMe}"><TextBlock Text="{l:T 'Вы', 'You'}" /></Border>
                                    </StackPanel>
                                    <TextBlock Classes="subtle" FontSize="13" Margin="0,2,0,0" Text="{Binding Subtitle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                    <Button Classes="accent" Command="{Binding ExportCommand}" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:Icon Width="16" Height="16" StrokeThickness="2" Data="{StaticResource IconDownload}" />
                                            <TextBlock Text="{l:T 'Экспорт профиля', 'Export profile'}" VerticalAlignment="Center" />
                                            <Border Background="#1F10140A" CornerRadius="4" Padding="5,1">
                                                <TextBlock Classes="mono" FontSize="11" FontWeight="Normal" Text="Ctrl+E" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Classes="subtle" FontSize="12" Text="{Binding StatusText}" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Right" />
                                </StackPanel>
                            </Grid>

                            <!-- Предсказуемость и роли -->
                            <Grid ColumnDefinitions="320,14,*">
                                <Border Classes="card" Padding="18">
                                    <StackPanel Spacing="14">
                                        <TextBlock Classes="caption" Text="{l:T 'ПРЕДСКАЗУЕМОСТЬ', 'PREDICTABILITY'}" />
                                        <Grid ColumnDefinitions="104,*" ColumnSpacing="16">
                                            <Panel Width="104" Height="104">
                                                <Ellipse Stroke="{StaticResource TrackBrush}" StrokeThickness="10" Margin="0" />
                                                <Arc Stroke="{StaticResource AccentBrush}" StrokeThickness="10" StrokeLineCap="Round"
                                                     StartAngle="-90" SweepAngle="{Binding PredictabilityAngle}" />
                                                <TextBlock Classes="mono" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Text="{Binding Predictability, StringFormat='{}{0}%'}" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding PredictabilityLabel}" TextWrapping="Wrap" />
                                                <TextBlock Classes="muted" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Text="{x:Static vm:ProfileViewModel.PredictabilityHint}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding RoleCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="14" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RoleCardViewModel">
                                            <Border Classes="card" Padding="18">
                                                <StackPanel Spacing="12">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                                        <Border Classes="badge" Classes.t="{Binding IsT}" Classes.ct="{Binding !IsT}">
                                                            <TextBlock Text="{Binding SideText}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1" FontSize="16" FontWeight="SemiBold" Text="{Binding RoleTitle}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Classes="muted" FontSize="13" Text="{Binding RoleHint}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                     Fill="{Binding Confidence, Converter={x:Static vm:ProfileConverters.ConfidenceBrush}}" />
                                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding ConfidenceText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Metrics}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="8" RowSpacing="8" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:MetricTile">
                                                                <Border Classes="tile">
                                                                    <StackPanel Spacing="2">
                                                                        <TextBlock Classes="subtle" FontSize="11.5" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Classes="mono" FontSize="18" FontWeight="SemiBold" Text="{Binding Value}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap" Text="{Binding Reasons}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <!-- T против CT -->
                            <Border Classes="card" Padding="18,16" IsVisible="{Binding !!Comparison.Count}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="14" Margin="0,0,0,6">
                                        <TextBlock Classes="caption" Text="{l:T 'T ПРОТИВ CT', 'T VS CT'}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource TBrush}" />
                                            <TextBlock Classes="t" FontSize="12" Text="T" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                            <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource CtLineBrush}" />
                                            <TextBlock Classes="ct" FontSize="12" Text="CT" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Comparison}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="32" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CompareRowViewModel">
                                                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" MinHeight="36">
                                                    <Grid ColumnDefinitions="150,80,*,80" ColumnSpacing="10">
                                                        <TextBlock Classes="muted" FontSize="13" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Classes="mono t" FontSize="13" TextAlignment="Right" Text="{Binding TText}" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="2" ColumnDefinitions="*,2,*" VerticalAlignment="Center">
                                                            <ProgressBar Classes="bar flat t" Minimum="0" Maximum="1" Value="{Binding TFraction}" FlowDirection="RightToLeft" />
                                                            <ProgressBar Grid.Column="2" Classes="bar flat ct" Minimum="0" Maximum="1" Value="{Binding CtFraction}" />
                                                        </Grid>
                                                        <TextBlock Grid.Column="3" Classes="mono ct" FontSize="13" Text="{Binding CtText}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Демки сводного профиля -->
                            <Border Classes="card" Padding="18" IsVisible="{Binding IsCombined}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="caption" Text="{l:T 'ДЕМКИ В ПРОФИЛЕ', 'DEMOS IN THE PROFILE'}" />
                                        <TextBlock Classes="hint" FontSize="12.5"
                                                   Text="{l:T 'Раунды всех демок пронумерованы подряд — по диапазону видно, из какой демки раунд-пример паттерна.', 'Rounds of all demos are numbered consecutively; the range shows which demo a pattern example round comes from.'}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Parts}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MatchPartRowViewModel">
                                                <Border Classes="inset" Padding="12,8" MinWidth="230">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                                            <TextBlock Classes="subtle" FontSize="11.5">
                                                                <Run Text="{Binding DateText}" />
                                                                <Run Text="·" />
                                                                <Run Classes="mono" Text="{Binding RoundsText}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Classes="mono" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Classes.positive="{Binding IsWin}" Classes.negative="{Binding IsLoss}" Text="{Binding ScoreText}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Паттерны -->
                            <StackPanel Spacing="12">
                                <WrapPanel ItemSpacing="14" LineSpacing="8">
                                    <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <Run Text="{l:T 'Паттерны', 'Patterns'}" />
                                        <Run Classes="mono" FontWeight="Medium" Foreground="{StaticResource SubtleBrush}" Text="{Binding PatternCount}" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="subtle" Text="{l:T 'Частота ≥, %', 'Frequency ≥, %'}" VerticalAlignment="Center" />
                                        <NumericUpDown Value="{Binding MinSharePercent}" Minimum="10" Maximum="100" Increment="5" FormatString="0" Width="120" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="subtle" Text="{l:T 'Примеров ≥', 'Examples ≥'}" VerticalAlignment="Center" />
                                        <NumericUpDown Value="{Binding MinExamples}" Minimum="1" Maximum="20" Increment="1" FormatString="0" Width="110" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="subtle" Text="{l:T 'Сортировка', 'Sort'}" VerticalAlignment="Center" />
                                        <ComboBox ItemsSource="{x:Static vm:ProfileViewModel.SortModes}" SelectedItem="{Binding SelectedSort}"
                                                  ItemTemplate="{StaticResource OptionTemplate}" />
                                    </StackPanel>
                                </WrapPanel>

                                <ListBox Theme="{StaticResource ChipList}" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                         ItemTemplate="{StaticResource OptionTemplate}" />

                                <TextBlock IsVisible="{Binding !Patterns.Count}" Classes="hint" Margin="4,8"
                                           Text="{l:T 'Устойчивых паттернов при заданных порогах нет. Попробуйте снизить порог частоты или числа примеров.', 'No stable patterns at these thresholds. Try lowering the frequency or examples threshold.'}" />
                                <ListBox Theme="{StaticResource CardList}" ItemsSource="{Binding Patterns}" SelectedItem="{Binding SelectedPattern}"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Background" Value="{StaticResource CardBrush}" />
                                            <Setter Property="CornerRadius" Value="14" />
                                            <Setter Property="Padding" Value="16,14" />
                                            <Setter Property="Margin" Value="0,0,0,8" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PatternRowViewModel">
                                            <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="18">
                                                <StackPanel Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Classes="badge" Classes.t="{Binding IsT}" Classes.ct="{Binding !IsT}">
                                                            <TextBlock Text="{Binding SideText}" />
                                                        </Border>
                                                        <Border Classes="badge neutral"><TextBlock Text="{Binding CategoryText}" /></Border>
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                     Fill="{Binding Pattern.Confidence, Converter={x:Static vm:ProfileConverters.ConfidenceBrush}}" />
                                                            <TextBlock Classes="muted" FontSize="12" Text="{Binding ConfidenceText}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock FontSize="14.5" FontWeight="Medium" LineHeight="20" TextWrapping="Wrap" Text="{Binding Text}" />
                                                    <TextBlock Classes="subtle" FontSize="12" TextWrapping="Wrap">
                                                        <Run Text="{l:T 'Раунды:', 'Rounds:'}" />
                                                        <Run Classes="mono" Foreground="{StaticResource MutedBrush}" Text="{Binding RoundsText}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Classes="subtle" FontSize="12" VerticalAlignment="Bottom">
                                                            <Run Classes="mono" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Text="{Binding CountText}" />
                                                            <Run Text="{Binding TotalText}" />
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Classes="mono subtle" FontSize="12" Text="{Binding PercentText}" VerticalAlignment="Bottom" />
                                                    </Grid>
                                                    <ProgressBar Classes="bar" Classes.t="{Binding IsT}" Classes.ct="{Binding !IsT}"
                                                                 Minimum="0" Maximum="1" Value="{Binding Share}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" VerticalAlignment="Center"
                                                        Command="{Binding $parent[ListBox].((vm:ProfileViewModel)DataContext).ShowOnRadarCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <controls:Icon Width="16" Height="16" Data="{StaticResource IconTarget}" />
                                                        <TextBlock Text="{l:T 'На радаре', 'On radar'}" FontWeight="Medium" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Classes="hint" FontSize="12.5" IsVisible="{Binding IsCombined}"
                                           Text="{l:T 'Паттерны посчитаны по всем раундам выбранных демок. Клик по паттерну подсвечивает раунды-примеры на радаре, «На радаре» — ещё и переключает на него.', 'Patterns are computed over all rounds of the selected demos. Clicking a pattern highlights its example rounds on the radar; “On radar” also switches to it.'}" />
                                <TextBlock Classes="hint" FontSize="12.5" IsVisible="{Binding !IsCombined}"
                                           Text="{l:T 'Одна демка — малая выборка: смотрите на «N из M» и уверенность. Клик по паттерну подсвечивает раунды-примеры на радаре, «На радаре» — ещё и переключает на него.', 'One demo is a small sample: look at “N of M” and confidence. Clicking a pattern highlights its example rounds on the radar; “On radar” also switches to it.'}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== Гранаты: эффективность и библиотека раскидок ===== -->
                <DockPanel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsGrenadesTab}" DataContext="{Binding Grenades}" x:DataType="vm:GrenadesViewModel">
                    <StackPanel DockPanel.Dock="Top" Margin="24,20,24,16">
                        <TextBlock Classes="h1" Text="{l:T 'Гранаты', 'Grenades'}" />
                        <TextBlock Classes="subtle" FontSize="13" Margin="0,2,0,0">
                            <Run Text="{Binding PlayerName}" />
                            <Run Text="{l:T '· какие гранаты принесли пользу, и лучшие раскидки', '· which grenades paid off, and the best lineups'}" />
                        </TextBlock>
                    </StackPanel>

                    <ScrollViewer>
                        <Grid ColumnDefinitions="*,14,400" Margin="24,0,24,32">
                            <StackPanel Spacing="14">
                                <Border Classes="card" Padding="24" IsVisible="{Binding !HasPlayer}">
                                    <StackPanel Spacing="8" MaxWidth="640" HorizontalAlignment="Left">
                                        <TextBlock Classes="h2" Text="{l:T 'Эффективность гранат', 'Grenade effectiveness'}" />
                                        <TextBlock Classes="hint"
                                                   Text="{l:T 'Откройте демку и выберите игрока слева: здесь появится, сколько урона нанесли его HE и молотовы, скольких противников ослепила каждая флешка — и скольких своих.', 'Open a demo and pick a player on the left: you will see how much damage their HEs and molotovs dealt, how many enemies each flash blinded, and how many teammates.'}" />
                                    </StackPanel>
                                </Border>

                                <!-- Плитки выбранного игрока -->
                                <ItemsControl ItemsSource="{Binding Tiles}" IsVisible="{Binding HasPlayer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Rows="1" ColumnSpacing="12" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GrenadeTile">
                                            <Border Classes="card" CornerRadius="14" Padding="16,14">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="subtle" FontSize="12" Text="{Binding Label}" />
                                                    <TextBlock Classes="mono" FontSize="26" FontWeight="SemiBold" Text="{Binding Value}" Classes.negative="{Binding IsWarning}" />
                                                    <TextBlock Classes="subtle" FontSize="12" Text="{Binding Detail}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Все игроки матча -->
                                <Border Classes="card" Padding="18" IsVisible="{Binding !!PlayerRows.Count}">
                                    <StackPanel Spacing="10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="caption" Text="{l:T 'ВСЕ ИГРОКИ МАТЧА', 'ALL PLAYERS OF THE MATCH'}" />
                                            <TextBlock Classes="hint" FontSize="12.5" TextWrapping="Wrap"
                                                       Text="{l:T 'HE и огонь — урон по противникам / брошено, флешки — ослеплено противников / брошено. «Убито ослепл.» — ослеплённые флешками игрока противники, которых убила его команда, пока они не видели.', 'HE and fire: damage to enemies / thrown; flashes: enemies blinded / thrown. Flash kills: enemies blinded by the player’s flashes and killed by the team while still blind.'}" />
                                        </StackPanel>
                                        <DataGrid ItemsSource="{Binding PlayerRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="True" RowHeight="36"
                                                  Classes="striped">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="{l:T 'Игрок', 'Player'}" Width="*" SortMemberPath="Name">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:PlayerGrenadeRow">
                                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <Border Classes="avatar" Classes.t="{Binding IsT}" Width="22" Height="22" CornerRadius="11">
                                                                    <TextBlock Text="{Binding Initials}" FontSize="9" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"
                                                                           FontWeight="{Binding NameWeight}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="HE" Binding="{Binding HeText}" SortMemberPath="HeDamage" x:DataType="vm:PlayerGrenadeRow" FontFamily="{StaticResource MonoFont}" />
                                                <DataGridTextColumn Header="{l:T 'Огонь', 'Fire'}" Binding="{Binding FireText}" SortMemberPath="FireDamage" x:DataType="vm:PlayerGrenadeRow" FontFamily="{StaticResource MonoFont}" />
                                                <DataGridTextColumn Header="{l:T 'Флешки', 'Flashes'}" Binding="{Binding FlashText}" SortMemberPath="EnemiesBlinded" x:DataType="vm:PlayerGrenadeRow" FontFamily="{StaticResource MonoFont}" />
                                                <DataGridTextColumn Header="{l:T 'Слепота, с', 'Blind, s'}" Binding="{Binding BlindSecondsText}" x:DataType="vm:PlayerGrenadeRow" FontFamily="{StaticResource MonoFont}" />
                                                <DataGridTextColumn Header="{l:T 'Убито ослепл.', 'Flash kills'}" Binding="{Binding FlashKills}" x:DataType="vm:PlayerGrenadeRow" FontFamily="{StaticResource MonoFont}" />
                                                <DataGridTemplateColumn Header="{l:T 'Своих ослепил', 'Team flashed'}" SortMemberPath="TeammatesBlinded">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:PlayerGrenadeRow">
                                                            <TextBlock Classes="mono" Margin="12,0" VerticalAlignment="Center" Text="{Binding TeammatesBlinded}" Classes.negative="{Binding HasTeammatesBlinded}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{l:T 'Урон своим', 'Team dmg'}" SortMemberPath="TeamDamage">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate x:DataType="vm:PlayerGrenadeRow">
                                                            <TextBlock Classes="mono" Margin="12,0" VerticalAlignment="Center" Text="{Binding TeamDamage}" Classes.negative="{Binding HasTeamDamage}" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="{l:T 'Дым', 'Smokes'}" Binding="{Binding Smokes}" x:DataType="vm:PlayerGrenadeRow" FontFamily="{StaticResource MonoFont}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Броски выбранного игрока -->
                                <Border Classes="card" Padding="18" IsVisible="{Binding HasPlayer}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Classes="caption" Text="{l:T 'БРОСКИ ИГРОКА', 'PLAYER THROWS'}" />
                                                <TextBlock Classes="hint" FontSize="12.5" TextWrapping="Wrap"
                                                           Text="{l:T 'Понравившийся бросок сохраните в библиотеку раскидок или сразу скопируйте команды setpos / setang.', 'Save a throw you like to the lineup library, or copy its setpos / setang commands right away.'}" />
                                            </StackPanel>
                                            <ListBox Grid.Column="1" Theme="{StaticResource ChipList}" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}"
                                                     ItemTemplate="{StaticResource OptionTemplate}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Classes="subtle" FontSize="12.5" IsVisible="{Binding !HasPlayerThrows}"
                                                   Text="{l:T 'Бросков нет.', 'No throws.'}" />
                                        <ItemsControl ItemsSource="{Binding ThrowRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GrenadeOutcomeRow">
                                                    <Border Classes="inset" Padding="12,8" Margin="0,0,0,6">
                                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                                                            <Button Grid.Column="3" Classes="icon-button" VerticalAlignment="Center"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).WatchThrowCommand}" CommandParameter="{Binding Throw}"
                                                                    ToolTip.Tip="{l:T 'Смотреть на радаре: раунд откроется на таймлайне за 2 с до броска, на паузе — нажмите «Пуск» и смотрите полёт', 'Watch on the radar: the round opens on the timeline 2 s before the throw, paused; press Play to watch the flight'}">
                                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconPlay}" />
                                                            </Button>
                                                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Header}" />
                                                                <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" Text="{Binding RouteText}" TextWrapping="Wrap" />
                                                                <TextBlock FontSize="12" Classes="subtle" Text="{Binding OutcomeText}" TextWrapping="Wrap" IsVisible="{Binding HasOutcome}"
                                                                           Classes.positive="{Binding PaidOff}" Classes.negative="{Binding HurtTeam}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Classes="icon-button" VerticalAlignment="Center"
                                                                    Command="{Binding $parent[ItemsControl].((vm:GrenadesViewModel)DataContext).CopyThrowCommand}" CommandParameter="{Binding Throw}"
                                                                    ToolTip.Tip="{l:T 'Скопировать setpos / setang', 'Copy setpos / setang'}">
                                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconCopy}" />
                                                            </Button>
                                                            <Button Grid.Column="2" Classes="icon-button" VerticalAlignment="Center"
                                                                    Command="{Binding $parent[ItemsControl].((vm:GrenadesViewModel)DataContext).SaveThrowCommand}" CommandParameter="{Binding Throw}"
                                                                    ToolTip.Tip="{l:T 'Сохранить в библиотеку раскидок', 'Save to the lineup library'}">
                                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconBookmark}" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Библиотека раскидок -->
                            <Border Grid.Column="2" Classes="card" Padding="18" VerticalAlignment="Top">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="caption" Text="{l:T 'БИБЛИОТЕКА РАСКИДОК', 'LINEUP LIBRARY'}" />
                                        <TextBlock Classes="hint" FontSize="12.5" TextWrapping="Wrap"
                                                   Text="{l:T 'Кнопка копирования кладёт в буфер setpos и setang. На своём сервере с sv_cheats 1 вставьте их в консоль — окажетесь в точке броска и с тем же прицелом.', 'The copy button puts setpos and setang on the clipboard. Paste them into the console on your own server with sv_cheats 1 and you stand on the throw spot with the same aim.'}" />
                                    </StackPanel>

                                    <StackPanel Spacing="8" IsVisible="{Binding HasLineups}">
                                        <ListBox Theme="{StaticResource ChipList}" ItemsSource="{Binding LineupMaps}" SelectedItem="{Binding SelectedLineupMap}"
                                                 ItemTemplate="{StaticResource OptionTemplate}" />
                                        <ListBox Theme="{StaticResource ChipList}" ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedLineupType}"
                                                 ItemTemplate="{StaticResource OptionTemplate}" />
                                        <TextBlock Classes="subtle" FontSize="12" Text="{Binding LineupSummary}" />
                                    </StackPanel>

                                    <TextBlock Classes="hint" FontSize="12.5" TextWrapping="Wrap" IsVisible="{Binding HasNoLineups}"
                                               Text="{l:T 'Раскидок пока нет. Сохраните бросок кнопкой с закладкой — здесь, в списке бросков игрока, или на радаре во вкладке «Гранаты».', 'No lineups yet. Save a throw with the bookmark button, here in the player throws or on the radar in the Grenades tab.'}" />

                                    <ItemsControl ItemsSource="{Binding Lineups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LineupRowViewModel">
                                                <Border Classes="inset" Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                                                            <Border Classes="badge neutral"><TextBlock Text="{Binding TypeText}" /></Border>
                                                            <Border Grid.Column="1" Classes="badge" Classes.t="{Binding IsT}" Classes.ct="{Binding !IsT}">
                                                                <TextBlock Text="{Binding SideText}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="2" Classes="subtle mono" FontSize="11.5" Text="{Binding MapName}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="3" Classes="icon-button compact"
                                                                    Command="{Binding $parent[ItemsControl].((vm:GrenadesViewModel)DataContext).RemoveLineupCommand}" CommandParameter="{Binding}"
                                                                    ToolTip.Tip="{l:T 'Удалить раскидку', 'Remove the lineup'}">
                                                                <controls:Icon Width="15" Height="15" Data="{StaticResource IconTrash}" />
                                                            </Button>
                                                        </Grid>
                                                        <TextBox FontSize="13.5" FontWeight="SemiBold" MinHeight="32" Text="{Binding Title, UpdateSourceTrigger=LostFocus}"
                                                                 ToolTip.Tip="{l:T 'Название можно изменить', 'You can rename it'}" />
                                                        <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}" Text="{Binding RouteText}" TextWrapping="Wrap" />
                                                        <TextBlock Classes="subtle" FontSize="11.5" Text="{Binding SourceText}" TextWrapping="Wrap" />
                                                        <TextBlock Classes="hint" FontSize="11.5" TextWrapping="Wrap" IsVisible="{Binding IsJumpThrow}"
                                                                   Text="{l:T 'Бросок в прыжке: setpos поставит вас в воздух, после приземления вы окажетесь там, откуда прыгали.', 'Jump throw: setpos puts you in the air; after landing you stand where the jump started.'}" />
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <SelectableTextBlock Classes="mono subtle" FontSize="11" Text="{Binding Command}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Classes="small accent"
                                                                    Command="{Binding $parent[ItemsControl].((vm:GrenadesViewModel)DataContext).CopyLineupCommand}" CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <controls:Icon Width="14" Height="14" StrokeThickness="2" Data="{StaticResource IconCopy}" />
                                                                    <TextBlock Text="{l:T 'Копировать', 'Copy'}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <SelectableTextBlock Classes="subtle mono" FontSize="11" Text="{Binding LibraryPath}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Библиотека и сводный профиль ===== -->
                <DockPanel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsLibraryTab}" DataContext="{Binding Library}" x:DataType="vm:LibraryViewModel">
                    <Grid DockPanel.Dock="Top" Margin="24,20,24,16" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="h1" Text="{l:T 'Библиотека', 'Library'}" />
                            <TextBlock Classes="subtle" FontSize="13" Margin="0,2,0,0" Text="{Binding Summary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Command="{Binding RescanCommand}" IsVisible="{Binding HasFolders}"
                                    ToolTip.Tip="{l:T 'Разобрать новые и изменённые демки во всех папках', 'Parse new and changed demos in all folders'}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:Icon Width="16" Height="16" Data="{StaticResource IconRefresh}" />
                                    <TextBlock Text="{l:T 'Обновить', 'Rescan'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="accent" Command="{Binding AddFolderCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <controls:Icon Width="16" Height="16" StrokeThickness="2" Data="{StaticResource IconOpen}" />
                                    <TextBlock Text="{l:T 'Добавить папку с демками', 'Add a demo folder'}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Прогресс импорта и сборки профиля -->
                    <Border DockPanel.Dock="Top" Classes="card" Margin="24,0,24,14" Padding="16,12" IsVisible="{Binding IsBusy}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                            <StackPanel Spacing="8">
                                <TextBlock FontSize="13" Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Classes="bar thick" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="ghost small" VerticalAlignment="Center" Content="{l:T 'Остановить', 'Stop'}" Command="{Binding CancelCommand}" />
                        </Grid>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="28,0,24,14" TextWrapping="Wrap" Text="{Binding StatusText}"
                               IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <ScrollViewer>
                        <Grid ColumnDefinitions="*,14,340" Margin="24,0,24,32">
                            <!-- Пустая библиотека -->
                            <Border Classes="card" Padding="24" IsVisible="{Binding !HasEntries}" VerticalAlignment="Top">
                                <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
                                    <TextBlock Classes="h2" Text="{l:T 'Профиль по нескольким демкам', 'Profile across many demos'}" />
                                    <TextBlock Classes="hint"
                                               Text="{l:T 'Одна демка — малая выборка, несколько демок дают уверенные выводы. Добавьте папку с демками: DemReview разберёт их один раз и сохранит анализ здесь. Дальше сводный профиль строится из библиотеки за секунды — даже если сами файлы .dem уже удалены.', 'One demo is a small sample; several demos give confident conclusions. Add a demo folder: DemReview parses the demos once and keeps the analysis here. After that the combined profile is built from the library in seconds, even if the .dem files themselves are gone.'}" />
                                    <TextBlock Classes="hint"
                                               Text="{l:T 'Если выбран основной игрок, каждая открытая демка с вашим участием тоже сохраняется сюда — так собирается «Мой профиль».', 'If the main player is set, every opened demo you played in is saved here too; that is how “My profile” builds up.'}" />
                                </StackPanel>
                            </Border>

                            <!-- Сводный профиль -->
                            <Border Classes="card" Padding="20" IsVisible="{Binding HasEntries}" VerticalAlignment="Top">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="h2" Text="{l:T 'Сводный профиль', 'Combined profile'}" />
                                        <TextBlock Classes="hint"
                                                   Text="{l:T 'Игрок находится в каждой демке по SteamID; паттерны, роли и тепловые карты считаются по всем выбранным матчам вместе. Чем больше раундов, тем выше уверенность в каждом паттерне.', 'The player is found in each demo by SteamID; patterns, roles and heatmaps are computed across all selected matches together. More rounds mean more confidence in every pattern.'}" />
                                    </StackPanel>

                                    <!-- Игрок -->
                                    <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="12">
                                        <TextBlock Classes="muted" FontSize="13.5" Text="{l:T 'Игрок', 'Player'}" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" MaxDropDownHeight="420"
                                                  ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LibraryPlayerOption">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Border Classes="avatar" Classes.me="{Binding IsMe}" Width="22" Height="22" CornerRadius="11">
                                                            <TextBlock Text="{Binding Initials}" FontSize="9" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <Border Classes="badge me" IsVisible="{Binding IsMe}"><TextBlock Text="{l:T 'Вы', 'You'}" /></Border>
                                                        <TextBlock Classes="subtle" FontSize="12" Text="{Binding CountText}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Grid.Column="2" Command="{Binding ShowMyProfileCommand}" IsEnabled="{Binding HasMainPlayer}"
                                                ToolTip.Tip="{l:T 'Основной игрок задаётся в «Настройках» или выбором себя в демке', 'The main player is set in Settings or by picking yourself in a demo'}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconProfile}" />
                                                <TextBlock Text="{l:T 'Мой профиль', 'My profile'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Карта -->
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="12">
                                        <TextBlock Classes="muted" FontSize="13.5" Text="{l:T 'Карта', 'Map'}" VerticalAlignment="Center" />
                                        <ListBox Grid.Column="1" Theme="{StaticResource ChipList}" ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LibraryMapOption">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding MapName}" />
                                                        <TextBlock Classes="mono" Opacity="0.6" Text="{Binding CountText}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    <TextBlock Classes="hint" FontSize="12.5" Margin="102,-8,0,0"
                                               Text="{l:T 'Профиль строится по одной карте: привычки игрока на Mirage и на Nuke обычно сильно отличаются.', 'The profile is built per map: a player’s habits on Mirage and on Nuke are usually very different.'}" />

                                    <!-- Демки -->
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Classes="caption" Text="{l:T 'ДЕМКИ ИГРОКА НА КАРТЕ', 'PLAYER DEMOS ON THE MAP'}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="ghost small" Content="{l:T 'Все', 'All'}" Command="{Binding SelectAllCommand}" />
                                            <Button Grid.Column="2" Classes="ghost small" Content="{l:T 'Ни одной', 'None'}" Command="{Binding SelectNoneCommand}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Demos}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LibraryDemoRowViewModel">
                                                    <Border Classes="inset" Padding="12,8" Margin="0,0,0,6" ToolTip.Tip="{Binding Tooltip}">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,110,Auto,Auto" ColumnSpacing="12">
                                                            <CheckBox IsChecked="{Binding IsIncluded}" VerticalAlignment="Center" MinWidth="0" />
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                                                                    <Border Classes="badge neutral" IsVisible="{Binding FileMissing}">
                                                                        <TextBlock Text="{l:T 'файла нет', 'file gone'}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Classes="subtle" FontSize="11.5">
                                                                    <Run Text="{Binding DateText}" />
                                                                    <Run Text="·" />
                                                                    <Run Text="{Binding RoundsText}" />
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Classes="mono" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       Classes.positive="{Binding IsWin}" Classes.negative="{Binding IsLoss}" Text="{Binding ScoreText}" />
                                                            <TextBlock Grid.Column="3" Classes="mono subtle" FontSize="12.5" VerticalAlignment="Center" TextAlignment="Right"
                                                                       Text="{Binding KdaText}" ToolTip.Tip="{l:T 'Убийства / смерти / помощь', 'Kills / deaths / assists'}" />
                                                            <Button Grid.Column="4" Classes="icon-button" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenDemoCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="{l:T 'Открыть только эту демку', 'Open only this demo'}">
                                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconExternal}" />
                                                            </Button>
                                                            <Button Grid.Column="5" Classes="icon-button" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).RemoveDemoCommand}"
                                                                    CommandParameter="{Binding}" ToolTip.Tip="{l:T 'Убрать из библиотеки (файл не удаляется)', 'Remove from the library (the file is kept)'}">
                                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconTrash}" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Border Classes="divider" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock FontSize="13.5" FontWeight="SemiBold" Text="{Binding SelectionText}" />
                                            <TextBlock Classes="hint" FontSize="12.5" TextWrapping="Wrap" Text="{Binding SelectionHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="accent" Command="{Binding BuildProfileCommand}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Icon Width="16" Height="16" StrokeThickness="2" Data="{StaticResource IconProfile}" />
                                                <TextBlock Text="{l:T 'Построить профиль', 'Build the profile'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Папки, мой профиль, хранилище -->
                            <StackPanel Grid.Column="2" Spacing="14">
                                <Border Classes="card" Padding="18">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="caption" Text="{l:T 'ПАПКИ С ДЕМКАМИ', 'DEMO FOLDERS'}" />
                                            <TextBlock Classes="hint" FontSize="12.5"
                                                       Text="{l:T 'Демки разбираются один раз, включая подпапки. «Обновить» добавит новые матчи.', 'Demos are parsed once, subfolders included. Rescan adds new matches.'}" />
                                        </StackPanel>
                                        <TextBlock Classes="subtle" FontSize="12.5" IsVisible="{Binding !HasFolders}" Text="{l:T 'Папок пока нет.', 'No folders yet.'}" />
                                        <ItemsControl ItemsSource="{Binding Folders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:LibraryFolderViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,0,8">
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Classes="mono" FontSize="12" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                            <TextBlock Classes="subtle" FontSize="11.5" Text="{Binding CountText}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Classes="icon-button compact" IsEnabled="{Binding Exists}"
                                                                Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenFolderCommand}" CommandParameter="{Binding}"
                                                                ToolTip.Tip="{l:T 'Открыть папку', 'Open the folder'}">
                                                            <controls:Icon Width="15" Height="15" Data="{StaticResource IconExternal}" />
                                                        </Button>
                                                        <Button Grid.Column="2" Classes="icon-button compact"
                                                                Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).RemoveFolderCommand}" CommandParameter="{Binding}"
                                                                ToolTip.Tip="{l:T 'Не следить за папкой (разобранные демки останутся в библиотеке)', 'Stop watching the folder (parsed demos stay in the library)'}">
                                                            <controls:Icon Width="15" Height="15" Data="{StaticResource IconClose}" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="18">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="caption" Text="{l:T 'МОЙ ПРОФИЛЬ', 'MY PROFILE'}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <TextBlock FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Text="{l:T 'Сохранять в библиотеку каждую открытую демку, где я играю', 'Save every opened demo I play in to the library'}" />
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SaveMyDemos}" />
                                        </Grid>
                                        <TextBlock Classes="hint" FontSize="12.5" TextWrapping="Wrap"
                                                   Text="{l:T 'Сводка каждой новой демки добавляется к прошлым — со временем получается подробный профиль вашей игры. Себя можно выбрать в демке или указать SteamID в «Настройках».', 'The summary of every new demo is added to the previous ones; over time this builds a detailed profile of your play. Pick yourself in a demo or enter your SteamID in Settings.'}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Padding="18" IsVisible="{Binding HasEntries}">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="caption" Text="{l:T 'ХРАНИЛИЩЕ', 'STORAGE'}" />
                                        <TextBlock Classes="hint" FontSize="12.5" TextWrapping="Wrap"
                                                   Text="{l:T 'Библиотека хранится отдельно от кеша и не очищается вместе с ним. Файлы .dem не изменяются и не удаляются.', 'The library is kept separately from the cache and is not cleared with it. The .dem files are never changed or deleted.'}" />
                                        <Button Classes="danger outlined" HorizontalAlignment="Left" Command="{Binding ClearLibraryCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Icon Width="15" Height="15" Data="{StaticResource IconTrash}" />
                                                <TextBlock Text="{Binding ClearButtonText}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- ===== Настройки ===== -->
                <DockPanel IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSettingsTab}" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
                    <StackPanel DockPanel.Dock="Top" Margin="24,20,24,16">
                        <TextBlock Classes="h1" Text="{l:T 'Настройки', 'Settings'}" />
                        <TextBlock Classes="subtle" FontSize="13" Margin="0,2,0,0">
                            <Run Text="{Binding Version, StringFormat='DemReview {0}'}" />
                            <Run Text="{l:T '· данные хранятся только на этом компьютере', '· data is stored only on this computer'}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Разделы -->
                    <StackPanel DockPanel.Dock="Left" Width="220" Margin="24,0,0,0" Spacing="2">
                        <StackPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="FontSize" Value="13.5" />
                            </Style>
                        </StackPanel.Styles>
                        <Button Classes="ghost" Tag="SectionUi" Click="OnSettingsSection" Content="{l:T 'Интерфейс', 'Interface'}" />
                        <Button Classes="ghost" Tag="SectionMe" Click="OnSettingsSection" Content="{l:T 'Основной игрок', 'Main player'}" />
                        <Button Classes="ghost" Tag="SectionCache" Click="OnSettingsSection" Content="{l:T 'Кеш и папки', 'Cache and folders'}" />
                        <Button Classes="ghost" Tag="SectionAnalysis" Click="OnSettingsSection" Content="{l:T 'Пороги анализа', 'Analysis thresholds'}" />
                        <Button Classes="ghost" Tag="SectionUpdates" Click="OnSettingsSection" Content="{l:T 'Обновления и приватность', 'Updates and privacy'}" />
                    </StackPanel>

                    <ScrollViewer x:Name="SettingsScroll" Margin="24,0,0,0">
                        <StackPanel Spacing="14" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,24,32">
                            <!-- Язык -->
                            <Border x:Name="SectionUi" Classes="card" Padding="20">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="h2" Text="{l:T 'Язык интерфейса', 'Interface language'}" />
                                        <TextBlock Classes="hint" Text="{l:T 'Интерфейс, формулировки паттернов и экспорт сразу переключаются на выбранный язык.', 'The interface, pattern wording and export switch to the selected language right away.'}" />
                                    </StackPanel>
                                    <ListBox Grid.Column="1" Theme="{StaticResource SegmentedList}" VerticalAlignment="Center"
                                             ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LanguageOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="16,9" />
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Основной игрок -->
                            <Border x:Name="SectionMe" Classes="card" Padding="20">
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="4">
                                        <TextBlock Classes="h2" Text="{l:T 'Основной игрок', 'Main player'}" />
                                        <TextBlock Classes="hint" Text="{l:T 'Выбирается сразу при открытии демки и отмечается «Вы» в списке игроков; демки с вашим участием сохраняются в «Библиотеку» и собираются в личный профиль. SteamID хранится только на этом компьютере.', 'Selected as soon as a demo opens and marked “You” in the player list; demos you played in are saved to the Library and build up a personal profile. The SteamID is stored only on this computer.'}" />
                                    </StackPanel>
                                    <Border Classes="inset" Padding="14">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                            <Border Classes="avatar" Classes.me="{Binding HasMainPlayer}" Width="40" Height="40" CornerRadius="20">
                                                <TextBlock Text="{Binding MainPlayerInitials}" FontSize="14" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock FontSize="14.5" FontWeight="SemiBold" Text="{Binding MainPlayerName}" />
                                                <TextBox Classes="mono" FontSize="12.5" Text="{Binding MainPlayerInput}" MinHeight="32"
                                                         PlaceholderText="{l:T 'SteamID64, ссылка на профиль, [U:1:…] или STEAM_0:…', 'SteamID64, profile link, [U:1:…] or STEAM_0:…'}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{l:T 'Сохранить', 'Save'}" Command="{Binding SaveMainPlayerCommand}" />
                                            <Button Grid.Column="3" Content="{l:T 'Выбрать в открытой демке', 'Pick in the open demo'}" Command="{Binding PickMainPlayerCommand}" />
                                            <Button Grid.Column="4" Classes="ghost danger" Content="{l:T 'Сбросить', 'Clear'}" Command="{Binding ClearMainPlayerCommand}"
                                                    IsEnabled="{Binding HasMainPlayer}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Classes="hint" Text="{Binding MainPlayerStatus}" IsVisible="{Binding MainPlayerStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <TextBlock FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   Text="{l:T 'Предлагать выбрать себя при открытии демки, пока основной игрок не выбран', 'Offer to pick yourself when a demo opens until the main player is set'}" />
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding AskForMainPlayer}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Кеш и папки -->
                            <Border x:Name="SectionCache" Classes="card" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="h2" Text="{l:T 'Кеш разобранных демок', 'Parsed demo cache'}" />
                                            <TextBlock Classes="hint" Text="{l:T 'Повторное открытие из кеша — секунды вместо полного разбора. Хранятся последние 50 демок; сами файлы .dem не трогаются.', 'Reopening from the cache takes seconds instead of a full parse. The last 50 demos are kept; the .dem files themselves are never touched.'}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="danger outlined" VerticalAlignment="Top" Command="{Binding ClearCacheCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:Icon Width="15" Height="15" Data="{StaticResource IconTrash}" />
                                                <TextBlock Text="{l:T 'Очистить кеш', 'Clear cache'}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock FontSize="13">
                                                <Run Classes="mono" FontWeight="SemiBold" Text="{Binding CacheCountText}" />
                                                <Run Foreground="{StaticResource SubtleBrush}" Text="{Binding CacheLimitText}" />
                                            </TextBlock>
                                            <TextBlock Grid.Column="1" Classes="mono muted" FontSize="13" Text="{Binding CacheSizeText}" />
                                        </Grid>
                                        <ProgressBar Classes="bar thick" Minimum="0" Maximum="{x:Static vm:SettingsViewModel.CacheMaximum}" Value="{Binding CacheEntries}" />
                                        <TextBlock Classes="hint" FontSize="12.5" Text="{Binding CacheStatus}"
                                                   IsVisible="{Binding CacheStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Border Classes="divider" />
                                        <Grid ColumnDefinitions="210,*,Auto" ColumnSpacing="12" Margin="0,12">
                                            <TextBlock Classes="muted" FontSize="13.5" Text="{l:T 'Данные, настройки, журналы', 'Data, settings, logs'}" VerticalAlignment="Center" />
                                            <SelectableTextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Foreground="{StaticResource Text2Brush}"
                                                                 Text="{Binding DataDirectory}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Classes="icon-button" Command="{Binding OpenDataFolderCommand}"
                                                    ToolTip.Tip="{l:T 'Открыть папку данных', 'Open the data folder'}">
                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconExternal}" />
                                            </Button>
                                        </Grid>
                                        <Border Classes="divider" />
                                        <Grid ColumnDefinitions="210,*,Auto" ColumnSpacing="12" Margin="0,12,0,0">
                                            <TextBlock Classes="muted" FontSize="13.5" Text="{l:T 'Изображения карт', 'Map images'}" VerticalAlignment="Center" />
                                            <SelectableTextBlock Grid.Column="1" Classes="mono" FontSize="12.5" Foreground="{StaticResource Text2Brush}"
                                                                 Text="{Binding MapsDirectory}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="2" Classes="icon-button" Command="{Binding OpenMapsFolderCommand}"
                                                    ToolTip.Tip="{l:T 'Открыть папку карт', 'Open the maps folder'}">
                                                <controls:Icon Width="16" Height="16" Data="{StaticResource IconExternal}" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Пороги анализа -->
                            <Border x:Name="SectionAnalysis" Classes="card" Padding="20">
                                <StackPanel Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Classes="h2" Text="{l:T 'Пороги анализа', 'Analysis thresholds'}" />
                                            <TextBlock Classes="hint" Text="{l:T 'Хранятся в settings.json в папке данных. Изменения применятся после «Анализировать заново» (F5); шаг выборки — после разбора без кеша (Shift+F5).', 'Stored in settings.json in the data folder. Changes apply after “Analyze again” (F5); the sampling step after a reparse without the cache (Shift+F5).'}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" Content="{l:T 'По умолчанию', 'Defaults'}"
                                                Command="{Binding ResetThresholdsCommand}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Thresholds}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="2" ColumnSpacing="10" RowSpacing="10" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ThresholdViewModel">
                                                <Border Classes="inset" CornerRadius="11" Padding="12,8">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock FontSize="13" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="mono subtle" FontSize="11" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <NumericUpDown Grid.Column="1" Width="120" Value="{Binding Value}" Minimum="{Binding Minimum}"
                                                                       Maximum="{Binding Maximum}" Increment="{Binding Increment}" FormatString="0" />
                                                        <TextBlock Grid.Column="2" Classes="subtle" FontSize="12" MinWidth="34" Text="{Binding Unit}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Обновления и приватность -->
                            <Border x:Name="SectionUpdates" Classes="card" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Classes="h2" Text="{l:T 'Обновления и приватность', 'Updates and privacy'}" />
                                    <Border Classes="inset" Padding="14,10" Background="#0F1A12" BorderBrush="#1F3A26">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                            <controls:Icon Width="18" Height="18" Brush="{StaticResource PositiveBrush}" StrokeThickness="2" Data="{StaticResource IconCheckCircle}" />
                                            <TextBlock Grid.Column="1" FontSize="13.5" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding UpdateSummaryText}" />
                                            <Button Grid.Column="2" Classes="small" Content="{l:T 'Проверить сейчас', 'Check now'}" Command="{Binding CheckUpdatesNowCommand}"
                                                    IsEnabled="{Binding HasRepository}" />
                                            <Button Grid.Column="3" Classes="ghost small" Foreground="{StaticResource AccentBrush}" Content="{l:T 'Страница проекта', 'Project page'}"
                                                    Command="{Binding OpenProjectPageCommand}" IsVisible="{Binding HasRepository}" />
                                        </Grid>
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="13.5" Text="{l:T 'Проверять новые версии на GitHub при запуске', 'Check GitHub for new versions on startup'}" />
                                            <TextBlock Classes="hint" FontSize="12.5" Text="{l:T 'Один запрос при запуске; без сети всё работает как обычно. Новая версия скачивается вручную со страницы релиза.', 'One request on startup; without a network everything works as usual. New versions are downloaded manually from the release page.'}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdates}" IsEnabled="{Binding HasRepository}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="13.5" Text="{l:T 'Отправлять анонимную статистику использования', 'Send anonymous usage statistics'}" />
                                            <TextBlock Classes="hint" FontSize="12.5" Text="{l:T 'Только два события: запуск программы и загрузка демки (карта, из кеша или разбор, время разбора), а также версия программы, ОС и язык системы. Имена файлов, ники, SteamID и постоянный идентификатор пользователя не отправляются. Сервис — Aptabase.', 'Only two events: app start and demo load (map, cache or parse, parse time), plus the app version, OS and system language. File names, nicknames, SteamIDs and a persistent user ID are never sent. Service: Aptabase.'}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SendUsageStatistics}" IsEnabled="{Binding HasAnalytics}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Panel>
        </DockPanel>
    </Grid>

</Window>

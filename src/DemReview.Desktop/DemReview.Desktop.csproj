<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\demreview.ico</ApplicationIcon>
    <AssemblyName>DemReview</AssemblyName>
    <RootNamespace>DemReview.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Single-file: сжатие уменьшает .exe примерно вдвое -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DemReview.Domain\DemReview.Domain.csproj" />
    <ProjectReference Include="..\DemReview.Application\DemReview.Application.csproj" />
    <ProjectReference Include="..\DemReview.Infrastructure\DemReview.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <!-- Отладочные символы нативных библиотек (SkiaSharp, HarfBuzz) в публикации не нужны -->
  <Target Name="RemoveNativePdbsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedPdb)" />
  </Target>
</Project>

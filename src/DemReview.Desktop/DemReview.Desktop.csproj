<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\demreview.ico</ApplicationIcon>
    <AssemblyName>DemReview</AssemblyName>
    <RootNamespace>DemReview.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Single-file: сжатие уменьшает .exe примерно вдвое -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Обычная сборка — только под ОС разработчика: иначе в bin копируются нативные библиотеки Skia
         для всех платформ (~600 МБ). При публикации RID задаётся явно (-r win-x64 / linux-x64). -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Папка maps/ из корня репозитория — рядом с exe и при сборке, и при публикации (не внутрь single-file) -->
    <None Include="..\..\maps\**" Link="maps\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DemReview.Domain\DemReview.Domain.csproj" />
    <ProjectReference Include="..\DemReview.Application\DemReview.Application.csproj" />
    <ProjectReference Include="..\DemReview.Infrastructure\DemReview.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <!-- Отладочные символы нативных библиотек (SkiaSharp, HarfBuzz) в публикации не нужны -->
  <Target Name="RemoveNativePdbsFromBuild" AfterTargets="Build">
    <ItemGroup>
      <_NativePdb Include="$(OutDir)libSkiaSharp.pdb;$(OutDir)libHarfBuzzSharp.pdb" />
    </ItemGroup>
    <Delete Files="@(_NativePdb)" />
  </Target>
  <Target Name="RemoveNativePdbsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishedPdb Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    <Delete Files="@(_PublishedPdb)" />
  </Target>
</Project>

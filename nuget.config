<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Пакеты хранятся внутри репозитория, глобальный кеш NuGet не используется -->
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
